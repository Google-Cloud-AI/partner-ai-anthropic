#
# Copy to terraform.tfvars and fill in. That file is gitignored — it holds the
# OAuth client secret.
#
#     cp terraform.tfvars.example terraform.tfvars
#
# ../deploy.sh generates this file from its prompts. If you run Terraform
# directly, note that terraform.tfvars OUTRANKS TF_VAR_* environment variables:
# a stale file here silently wins over anything you export.

# --- Required -------------------------------------------------------------

project_id = "my-gcp-project"

# Must be a region where the Claude models you need are published in Model
# Garden. Availability is per-region; check each model card.
region = "us-east5"

# OAuth 2.0 web-application client from your IdP.
oauth_client_id     = "1234567890-abcdefg.apps.googleusercontent.com"
oauth_client_secret = "GOCSPX-replace-me"

# The gateway's entire access-control list. "example.com" is rejected by a
# variable validation, because shipping the placeholder is a silent failure.
allowed_email_domain = "acme.com"

# --- Network topology -----------------------------------------------------
# Read docs/NETWORKING.md first. Both options are private: /login refuses any
# gateway that resolves publicly, so there is no public configuration.

# Option 1 (default): internal ingress, no load balancer.
# Requires pre-existing PSC + Cloud DNS private resolution for *.run.app.
ingress = "INGRESS_TRAFFIC_INTERNAL_ONLY"

# Option 2: behind an internal Application Load Balancer that you provision.
# ingress                = "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER"
# gateway_public_url     = "https://claude-gateway.internal.acme.com"
# proxy_only_subnet_cidr = "10.129.0.0/23"

# How Cloud Run's invoker check is satisfied. "allusers" grants allUsers
# roles/run.invoker; "external" creates no binding, for orgs where Domain
# Restricted Sharing blocks that. Either way the check must not be enforced.
invoker_mode = "allusers"

# --- Optional -------------------------------------------------------------

# gateway_version = "2.1.206"   # also the image tag; bumping forces a rebuild
# min_instances   = 1           # keep at 1: boot is fail-closed on Postgres
# db_tier         = "db-g1-small"
# db_deletion_protection = false
# vpc_name        = "cc-gateway-vpc"
# subnet_name     = "cc-gateway-subnet"
# subnet_cidr     = "10.0.0.0/24"
# build_image     = true        # false in CI where a pipeline stage pushes it
