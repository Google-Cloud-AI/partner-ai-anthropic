# Scoped to this module. The repository root .gitignore has no Terraform or
# gateway-specific rules, and these must not apply to the rest of the repo.

# ---------------------------------------------------------------------------
# Secrets and generated configuration
# ---------------------------------------------------------------------------
# terraform.tfvars is generated by deploy.sh from your answers and contains the
# OAuth client secret. terraform.tfvars.example is the committed template.
*.tfvars
!*.tfvars.example
config.env

# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
# State contains the generated Postgres password and the rendered gateway.yaml
# in plaintext. Never commit it; use the GCS backend in versions.tf instead.
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log
tfplan
*.tfplan

# ---------------------------------------------------------------------------
# Vendored gateway binary (~260 MB)
# ---------------------------------------------------------------------------
# Downloaded on demand by deploy.sh at the pinned gateway_version.
templates/claude
