# Vogue Concierge (React edition) — environment variables. Copy to .env and fill
# in your values.
#
# Prefer the guided path? `./bootstrap.sh` collects these interactively, deploys
# everything, and writes the generated ids (RAG_CORPUS_RESOURCE, TOOLBOX_URL,
# AGENT_ENGINE_ID) back into this file for you.
#
# The setup/deploy scripts read these from the environment (they do NOT auto-load
# .env), so export them first, e.g.:
#   set -a; source .env; set +a
# There are no working defaults: the app fails fast if VERTEXAI_PROJECT is unset.

# --- GCP project (REQUIRED) ---
VERTEXAI_PROJECT=your-gcp-project-id
# Your project NUMBER (not the id). Find it with:
#   gcloud projects describe "$VERTEXAI_PROJECT" --format="value(projectNumber)"
PROJECT_NUMBER=your-gcp-project-number

# --- Claude on Agent Platform ---
# Region that serves Claude in your project (enable the models in Agent Platform Model
# Garden first). "global" routes to available capacity and is recommended; use a
# specific region only if you have quota there for every model you use.
CLAUDE_VERTEX_REGION=global

# The right model for the right agent (bare Vertex model ids). Override only if
# your Model Garden exposes different or dated snapshot ids.
ORCHESTRATOR_MODEL=claude-sonnet-5
STYLE_MODEL=claude-opus-5
INVENTORY_MODEL=claude-haiku-4-5
RETURNS_MODEL=claude-haiku-4-5

# Reasoning effort. Sonnet 5 / Opus 5 default to "high"; these two are set
# explicitly so the orchestrator stays snappy. Haiku 4.5 takes no effort value.
ORCHESTRATOR_EFFORT=medium
STYLE_EFFORT=high

# --- RAG corpus (REQUIRED before deploying the agents) ---
# Printed by `python scripts/setup_rag.py`. Full resource name, e.g.
#   projects/<number>/locations/us-west1/ragCorpora/<id>
RAG_CORPUS_RESOURCE=

# --- Deployed agent (printed by deploy_agent_engine.py) ---
AGENT_ENGINE_ID=

# --- MCP Toolbox (BigQuery inventory/loyalty tools) ---
# REQUIRED. The Cloud Run URL printed by ./deploy_toolbox.sh. The service is
# private, and this URL is the audience of the ID token used to call it, so local
# `adk web` runs point at the deployed service too (with your own credentials).
TOOLBOX_URL=

# --- Agent Runtime deploy (optional) ---
# Staging bucket for deploy_agent_engine.py; defaults to gs://<project>-vogue-staging.
STAGING_BUCKET=

# --- Server port ---
PORT=8080
