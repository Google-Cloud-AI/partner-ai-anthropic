# Deployment configuration for the Claude Code OTel Collector.
#
# Copy this file to `config.env` and fill in your values (or run ./setup.sh,
# which writes config.env for you). `config.env` is gitignored — your real
# values never get committed. Every script in this repo sources config.env.

# ---- Required ---------------------------------------------------------------
# Your Google Cloud project ID (where the collector + telemetry live).
PROJECT=""

# ---- Cloud Run service ------------------------------------------------------
REGION="us-central1"
SERVICE="claude-otel-collector"
SECRET="otel-collector-config"          # Secret Manager entry for the config
CONTAINER_PORT="4318"                    # OTLP/HTTP receiver port
# Google-built OpenTelemetry Collector image (pin a version you trust).
IMAGE="us-docker.pkg.dev/cloud-ops-agents-artifacts/google-cloud-opentelemetry-collector/otelcol-google:0.151.0"
# --min-instances=1 guarantees capture (small always-on cost). Set 0 to scale
# to zero (no idle cost, but a cold start can drop the first batch after idle).
MIN_INSTANCES="1"
MAX_INSTANCES="2"
MEMORY="512Mi"

# ---- Identities -------------------------------------------------------------
# The collector's own runtime identity (exports to Logging/Monitoring/Trace).
RUNTIME_SA_NAME="otel-collector"
# A shared service account that laptop developers IMPERSONATE to mint an ID
# token (they have no metadata server). deploy.sh creates it and grants it
# roles/run.invoker.
INVOKER_SA_NAME="otel-invoker"

# Who may send telemetry. Each member is granted
# roles/iam.serviceAccountTokenCreator on the invoker SA so they can impersonate
# it. Prefer a domain or a group so you NEVER list individuals here — add/remove
# people in Google Workspace instead. Space-separated IAM members:
#   DEVELOPERS="domain:yourcompany.com"              # any authenticated org user (simplest)
#   DEVELOPERS="group:claude-users@yourcompany.com"  # manage membership in Workspace
#   DEVELOPERS="user:alice@acme.com user:bob@acme.com"   # explicit list (only if you must)
DEVELOPERS=""

# Machines whose ATTACHED service account sends directly via the GCP metadata
# server (e.g. Cloud Workstations, GCE VMs). Each is granted roles/run.invoker
# directly (no impersonation). Space-separated IAM members, e.g.:
#   INVOKER_MEMBERS="serviceAccount:1234567890-compute@developer.gserviceaccount.com"
INVOKER_MEMBERS=""

# ---- Cost reporting (BigQuery + Looker Studio; optional) --------------------
# ./cost-dashboard-setup.sh creates a BigQuery "linked dataset" over the
# _Default Log Analytics bucket (so the logs are queryable in BigQuery/Looker
# Studio) plus two EXACT cost views. These read the raw cost_usd on each event,
# so figures are exact — unlike the Cloud Monitoring log-based metric, which
# buckets values and is only approximate.
LOGLINK_ID="claude_code_la"   # name of the BigQuery linked dataset for the logs
BQ_DATASET="claude_code"      # dataset that holds the reporting views
BQ_LOCATION="US"              # BigQuery location for the views dataset
