# Copy to config.env (or run ./setup.sh, which writes it for you) and edit.
# config.env is gitignored, so it is safe to hold real values.

# ---- Required ---------------------------------------------------------------

# The GCP project telemetry lands in. Developers need roles/telemetry.writer here.
PROJECT=""

# The project billed for the API calls (sent as x-goog-user-project). Usually the
# same as PROJECT. If it differs, developers also need
# roles/serviceusage.serviceUsageConsumer on THIS project.
QUOTA_PROJECT=""

# Who may send telemetry. Space-separated IAM members. Prefer a domain or a group
# so you never have to maintain a list of individuals:
#   DEVELOPERS="domain:yourco.com"
#   DEVELOPERS="group:eng@yourco.com"
DEVELOPERS=""

# Service accounts of GCE VMs and Cloud Workstations that run Claude Code.
# REQUIRED if developers work on GCP compute, and easy to miss: on those
# machines otel-headers-helper.sh takes the metadata-server path, so the export
# is authenticated by the MACHINE's service account, not by the developer — even
# when that developer is signed in with gcloud. Granting DEVELOPERS alone leaves
# those exports rejected.
#
# This does not change attribution: user.email is resolved separately, per
# developer, by print-settings.sh.
#   MACHINE_MEMBERS="serviceAccount:1234567890-compute@developer.gserviceaccount.com"
MACHINE_MEMBERS=""

# ---- Resource attributes ------------------------------------------------------

# Reported as `location` when the metadata server is unreachable (laptops).
# Must be a real region — the endpoint rejects "global".
FALLBACK_LOCATION="us-central1"

# ---- BigQuery -----------------------------------------------------------------

# A Log Router sink writes the logs into BigQuery tables.

# Log Router sink name.
SINK_ID="oteltobq"

# BigQuery dataset the sink writes into. One partitioned table per event type.
SINK_DATASET="oteltobq"

# BigQuery location for the dataset. Must be set before the first write; you
# cannot move a dataset afterwards.
BQ_LOCATION="US"

# No retention knob here on purpose. Retention is a property of the _Default log
# bucket, which holds every other service's logs in the project, so changing it
# to suit Claude Code would shorten or bill everyone else's too. The exclusion
# at the end of enable-and-grant.sh is the cost control for these logs.
